# =============================================================================
# PocketSmart AI - backend environment TEMPLATE. Copy to .env and fill in.
# =============================================================================

# --- Supabase project ---------------------------------------------------------
# Fill these from: Supabase Dashboard -> Project Settings -> API / API Keys.
SUPABASE_PROJECT_NAME=YOUR_SUPABASE_PROJECT_NAME
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key (sb_publishable_...). Safe for browsers; RLS blocks it from every table here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Secret key (sb_secret_...). Bypasses RLS: server-side ONLY, never in frontend/ or git.
# NOTE: the backend does not need it - it talks to Postgres via DATABASE_URL below.
# Kept here for admin scripts / future server-side use. (Not the same as SECRET_KEY below!)
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# --- Database (Supabase PostgreSQL) ---------------------------------------------
# Supabase Dashboard -> Connect -> "Session pooler" (port 5432) is the right choice for
# this always-on server and for IPv4-only hosts such as Render's free tier.
#   Use the "Transaction pooler" (port 6543) only for serverless/short-lived hosts.
# The direct host db.<ref>.supabase.co is IPv6-only and fails on most IPv4 hosts.
# If the password contains special characters, URL-encode them (@ -> %40, # -> %23, / -> %2F).
# sslmode=require is added automatically for Supabase hosts.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Tables are created by supabase/schema.sql (run it once in the Supabase SQL editor).
# On PostgreSQL the app only VERIFIES them; leave this false so tables can never be
# auto-created without Row Level Security.
DB_AUTO_CREATE=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Only needed once, for backend/scripts/migrate_neon_to_supabase.py (your OLD Neon URL):
# SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require

# --- Security -------------------------------------------------------------------
# Signs login tokens (JWT). This value was generated for you; rotate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# "production" enforces SECRET_KEY and Secure (HTTPS-only) cookies.
# For plain http://127.0.0.1 testing in Safari, set ENVIRONMENT=development.
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_IDLE_MINUTES=30
COOKIE_SAMESITE=lax
# Comma-separated browser origins allowed to call the API cross-origin (never "*").
CORS_ORIGINS=https://pocketsmart-ai-theta.vercel.app,http://localhost:8000,http://127.0.0.1:8000

# --- Gemini AI (optional: without a key the app uses offline plans) --------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# --- Local server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Where the Jinja2 templates / static files live (default: ../frontend).
# FRONTEND_DIR=../frontend
