# =============================================================================
# PocketSmart AI - backend environment TEMPLATE.  Copy to backend/.env and fill in.
#   cp .env.example .env
# =============================================================================

# --- Database: Supabase PostgreSQL (REQUIRED) -----------------------------------
# Supabase Dashboard -> Connect -> "Session pooler" (port 5432).  It works on IPv4-only
# hosts such as Render's free tier.  (Use the "Transaction pooler", port 6543, only for
# serverless hosts.)  The direct host db.<ref>.supabase.co is IPv6-only and fails on most hosts.
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F, : -> %3A).
# SSL is enabled automatically for Supabase hosts.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Tables are created by supabase/schema.sql (run it once in the Supabase SQL editor).
# On start-up the API only VERIFIES them.  true = run supabase/schema.sql automatically instead.
DB_AUTO_CREATE=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=10

# Only needed once, for `npm run migrate:neon` (your OLD Neon URL):
# SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require

# --- Security ---------------------------------------------------------------------
# Signs login tokens (JWT).  REQUIRED in production.  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep the value you already use on Render and existing logins stay valid.
SECRET_KEY=
# "production" enforces SECRET_KEY and Secure (HTTPS-only) cookies.
# Use "development" for plain http://localhost work (and Safari).
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_IDLE_MINUTES=30
COOKIE_SAMESITE=lax
# Comma-separated browser origins allowed to call the API cross-origin (never "*").
# Only needed when the frontend is hosted on a DIFFERENT origin than the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- Gemini AI (optional: without a key the app uses offline plans) ---------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# --- Local server -----------------------------------------------------------------
# HOST defaults to 127.0.0.1 locally and 0.0.0.0 in production / on Render.
PORT=8000
# HOST=127.0.0.1
# Where the built React app lives (default ../frontend/dist).  When it exists the API
# serves it, so one process / one Render service hosts everything.
# FRONTEND_DIST=../frontend/dist
