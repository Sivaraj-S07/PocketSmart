# =============================================================================
# PocketSmart AI - frontend environment  (PUBLIC values only - never put secrets here)
# =============================================================================
# The pages are server-rendered Jinja2 templates served by the backend and ALL data
# access goes through the backend API, so no browser code talks to Supabase today and
# nothing in this file is read at runtime.  It is provided so that, if you later add
# supabase-js in the browser, the public values already live in the right place.
# The SECRET key must never appear in this folder.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
