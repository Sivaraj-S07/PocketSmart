# =============================================================================
# PocketSmart AI - frontend environment (PUBLIC values only - never put secrets here).
# Copy to frontend/.env if you need to change anything.  Defaults work for local development.
# =============================================================================

# Where `npm run dev` proxies /api requests (the Express backend).
# VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Leave EMPTY (recommended).  The app then calls /api on its own origin:
#   * dev:         Vite proxies /api to the backend
#   * production:  Express serves the built app, or Vercel/Netlify rewrite /api to the backend
#                  (see frontend/vercel.json and frontend/public/_redirects)
# Set it ONLY if the API lives on a different origin and you accept cross-site cookies, e.g.
#   VITE_API_URL=https://pocketsmart-api.onrender.com
# In that case also set on the backend:  CORS_ORIGINS=<your frontend origin>,
#   COOKIE_SAMESITE=none, ENVIRONMENT=production.
VITE_API_URL=
